# Ignore Python cache
__pycache__/
*.pyc

# Ignore environment files
.env

# NOTE: db/ is intentionally NOT ignored — the prebuilt Chroma vector store is
# committed via git-LFS (see .gitattributes) so the Hugging Face Space can load
# it directly without re-embedding on startup. Rebuild with `python -m src.ingest`.

# Ignore virtual environments
venv/
.venv/
